# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID (optional; only used by Kimi OAuth)
APP_SECRET=               # Secret used to sign the session JWT — REQUIRED, use a long random value

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:port/db)

# ── Admin login (username + password) ───────────────────────────
ADMIN_USER=dandan         # Admin username; defaults to "dandan" when blank
ADMIN_PASS=               # Admin password — REQUIRED in production. Set it in the Render dashboard, never here.

# ── Kimi OAuth (optional — leave blank to use username/password only) ──
KIMI_AUTH_URL=
KIMI_OPEN_URL=
OWNER_UNION_ID=           # Union ID that gets role "admin" on first OAuth login
